# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# JWT_SECRET: Signing key for JWT access/refresh tokens (auto-generated in memory if unset).
JWT_SECRET=

# OPENAI_API_KEY / OPENAI_BASE_URL: Optional OpenAI-compatible AI provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# MONGODB_URI: Optional external MongoDB connection string (uses embedded SQLite store by default).
MONGODB_URI=
